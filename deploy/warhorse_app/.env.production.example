#--------------------------------------------------------------------
# .env de PRODUCCIÓN — Warhorse en Hostinger (hosting compartido)
#
# Súbelo a ~/warhorse_app/.env (FUERA de public_html) y renómbralo a .env
# (sin el .example). NUNCA va en Git ni dentro del webroot.
#
# Rellena los valores marcados con <...> copiándolos de tu .env de
# desarrollo actual (apps/api/.env): son los mismos secretos.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'https://slategrey-skunk-457118.hostingersite.com/'
app.indexPage = ''
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# ENCRYPTION — copia la MISMA clave de tu .env actual (línea encryption.key).
# Si la cambias, invalidas tokens/datos cifrados existentes.
#--------------------------------------------------------------------
encryption.key = <copia encryption.key de tu .env de desarrollo>

#--------------------------------------------------------------------
# BASE DE DATOS (la misma de Hostinger que ya usas)
#--------------------------------------------------------------------
database.default.hostname = srv753.hstgr.io
database.default.database = u575426443_warhorse
database.default.username = u575426443_warAdmin
database.default.password = <copia database.default.password de tu .env de desarrollo>
database.default.DBDriver = MySQLi
database.default.DBDebug = false
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.port = 3306

# Nota: si la app corre DENTRO del mismo hosting de la BD, Hostinger suele
# permitir 'localhost' como hostname (más rápido y sin tope de conexiones
# remotas). Si 'srv753.hstgr.io' te da errores de conexión en producción,
# prueba con:
# database.default.hostname = localhost

#--------------------------------------------------------------------
# CORS — no se usa: SPA y API comparten origen (mismo dominio). Se deja el
# origen por si en el futuro separas el front en otro subdominio.
#--------------------------------------------------------------------
cors.allowedOrigin = 'https://slategrey-skunk-457118.hostingersite.com'
